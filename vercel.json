{
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(whatsagent-ai-landing|watsagent-ai-landing|whatsagent-landing|landing-page-ivory-six-32|woai-ai)\\.vercel\\.app"
        }
      ],
      "destination": "https://web.wogent.in/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "(whatsagent-ai-landing|watsagent-ai-landing|whatsagent-landing|landing-page-ivory-six-32|woai-ai)\\.vercel\\.app"
        }
      ],
      "destination": "https://web.wogent.in/:path*",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(robots.txt|sitemap.xml|llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/vendor/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000"
        }
      ]
    },
    {
      "source": "/site.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/(assets/(og-image.jpg|og-image.png|logo-512.png|icon-192.png|icon.svg)|apple-touch-icon.png|favicon.ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/(llms.txt|llms-full.txt)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ]
}

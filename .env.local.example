# Copy to .env.local and fill in whichever providers you have keys for.
# Every key you set joins the fallback chain in this order, so the free
# tiers stack — when one runs out, the next takes over. Providers with no
# key are skipped entirely. At least one is required.

# Largest free tier, no card required — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Fast; free tier is capped by tokens/day (~130 messages) — https://console.groq.com/keys
GROQ_API_KEY=

# 50 requests/day free, 1,000/day after a one-off $10 credit — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Promotes one model to the front of that provider's own list;
# the rest of the list still follows as fallbacks.
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=openai/gpt-oss-120b
# OPENROUTER_MODEL=inclusionai/ling-3.0-flash

# Where "Book a demo" submissions go. /api/lead POSTs each lead as JSON to
# this URL — a Google Apps Script web app, Zapier/Make webhook, Slack
# incoming webhook, or your own endpoint. Required for the form to work;
# without it the form shows "Booking isn't available right now".
LEAD_WEBHOOK_URL=
